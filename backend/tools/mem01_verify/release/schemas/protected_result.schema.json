       "provisional",
       "validated"
      ],
      "type": "string"
     },
     "denominator": {
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "denominator_def": {
      "type": [
       "string",
       "null"
      ]
     },
     "diagnostic_only": {
      "type": "boolean"
     },
     "directional": {
      "type": "boolean"
     },
     "errors": {
      "minimum": 0,
      "type": "integer"
     },
     "evaluated": {
      "minimum": 0,
      "type": "integer"
     },
     "evidence_basis": {
      "description": "Evidence letters.",
      "enum": [
       "F",
       "C",
       "F+C",
       "H-optimization",
       "H-test",
       "H-validation"
      ],
      "type": "string"
     },
     "expected": {
      "minimum": 0,
      "type": "integer"
     },
     "gate": {
      "enum": [
       "QS",
       "CH",
       "NF",
       "LANG",
       "IDEM",
       "VIS",
       "ERASE",
       "RET",
       "COV",
       "FID",
       "THR",
       "TIME",
       "IDENT",
       "RED",
       "ATTR",
       "SNAP",
       "EMB"
      ],
      "type": "string"
     },
     "id": {
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_.]+$",
      "type": "string"
     },
     "kind": {
      "description": "Ratio needs a denominator; count has none.",
      "enum": [
       "ratio",
       "count"
      ],
      "type": "string"
     },
     "minimum": {
      "minimum": 1,
      "type": [
       "integer",
       "null"
      ]
     },
     "numerator": {
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "operator": {
      "description": "Comparison against the threshold.",
      "enum": [
       "==",
       "<=",
       ">="
      ],
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "set": {
      "enum": [
       "QS",
       "CH",
       "NF",
       "LANG",
       "IDEM",
       "VIS",
       "ERASE",
       "RET",
       "COV",
       "FID",
       "THR",
       "TIME",
       "IDENT",
       "RED",
       "ATTR",
       "SNAP",
       "EMB"
      ],
      "type": "string"
     },
     "skipped": {
      "minimum": 0,
      "type": "integer"
     },
     "split": {
      "description": "The EVIDENCE source of the criterion - a different field from a record's `split`.",
      "enum": [
       "optimization",
       "test",
       "validation",
       "fixtures",
       "corpus"
      ],
      "type": "string"
     },
     "status": {
      "description": "Criterion status; a mandatory zero denominator is ERROR, never PASS.",
      "enum": [
       "PASS",
       "FAIL",
       "ERROR",
       "incomplete",
       "pending",
       "skipped",
       "N/A"
      ],
      "type": "string"
     },
     "threshold": {
      "type": "number"
     },
     "versions": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     }
