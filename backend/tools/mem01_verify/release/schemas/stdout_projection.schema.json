{
 "$id": "https://one-ai.local/mem01/step1/schemas/stdout_projection.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "description": "The hidden-safe projection printed between MEM01_RESULT_V1_BEGIN and MEM01_RESULT_V1_END (contract 3.4). `diagnostics`, `exclusions`, `opened_outside_closure` and per-gate reasons for hidden-evidence gates are NOT printed; criteria entries on the evaluated hidden split collapse to one entry per SET. On tuning runs the projection equals the protected result.",
 "properties": {
  "aborted": {
   "type": "boolean"
  },
  "aborted_at_step": {
   "maximum": 13,
   "minimum": 1,
   "type": [
    "integer",
    "null"
   ]
  },
  "baseline_label": {
   "type": "string"
  },
  "cache_hits": {
   "const": 0
  },
  "cache_policy": {
   "const": "forbidden"
  },
  "cleanup": {
   "additionalProperties": false,
   "properties": {
