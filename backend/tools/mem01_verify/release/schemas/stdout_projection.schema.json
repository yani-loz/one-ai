        "type": "string"
       },
       "reason": {
        "type": "string"
       },
       "set": {
        "enum": [
         "QS",
         "CH",
         "NF",
         "LANG",
         "IDEM",
         "VIS",
         "ERASE",
         "RET",
         "COV",
         "FID",
         "THR",
         "TIME",
         "IDENT",
         "RED",
         "ATTR",
         "SNAP",
         "EMB"
        ],
        "type": "string"
       },
       "skipped": {
        "minimum": 0,
        "type": "integer"
       },
       "split": {
        "description": "The EVIDENCE source of the criterion - a different field from a record's `split`.",
        "enum": [
         "optimization",
         "test",
         "validation",
         "fixtures",
         "corpus"
