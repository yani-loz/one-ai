     "type": "boolean"
    },
    "probe_dropped": {
     "type": "boolean"
    },
    "probe_name": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "probe_dropped",
    "probe_name",
    "kept"
   ],
   "type": "object"
  },
