{
 "$id": "https://one-ai.local/mem01/step1/schemas/protected_result.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "description": "The COMPLETE machine block written to the report directory (contract 3.3). It may carry per-case detail and per-gate reasons and therefore never leaves the report root; what is printed is the stdout projection.",
 "properties": {
  "aborted": {
   "type": "boolean"
  },
  "aborted_at_step": {
   "maximum": 13,
   "minimum": 1,
   "type": [
    "integer",
    "null"
   ]
  },
  "baseline_label": {
   "type": "string"
  },
  "cache_hits": {
   "const": 0
  },
  "cache_policy": {
   "const": "forbidden"
  },
  "cleanup": {
   "additionalProperties": false,
   "properties": {
    "kept": {
     "type": "boolean"
    },
    "probe_dropped": {
     "type": "boolean"
    },
    "probe_name": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "probe_dropped",
    "probe_name",
    "kept"
   ],
   "type": "object"
  },
  "code_hash": {
   "anyOf": [
    {
     "pattern": "^[0-9a-f]{64}$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "config_hash": {
   "anyOf": [
    {
     "pattern": "^[0-9a-f]{64}$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "corpus": {
   "additionalProperties": false,
   "properties": {
    "attachments": {
     "minimum": 0,
     "type": "integer"
    },
    "database": {
     "type": "string"
    },
    "emails": {
     "minimum": 0,
     "type": "integer"
    },
    "host": {
     "type": "string"
    },
    "org_id": {
     "type": "string"
    },
    "port": {
     "type": "integer"
    },
    "snapshot_transaction_id": {
     "type": "string"
    }
   },
   "required": [
    "org_id",
    "host",
    "port",
    "database",
    "emails",
    "attachments",
    "snapshot_transaction_id"
