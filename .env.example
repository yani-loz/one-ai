# Copy to .env and adjust for your machine. `.env` is gitignored — never commit secrets.

# ── PostgreSQL ──────────────────────────────────────────
# POSTGRES_* is the OWNER/superuser role: Alembic/DDL + role provisioning only (not runtime HTTP).
POSTGRES_USER=oneai
POSTGRES_PASSWORD=change_me_for_local_dev
POSTGRES_DB=oneai
POSTGRES_PORT=5432
# Backend reaches Postgres by the compose service name:
POSTGRES_HOST=db

# ── Least-privilege runtime DB roles (RLS role split) ───
# The running app connects as these, NOT as POSTGRES_USER. Migration 0009 creates the roles
# (NOLOGIN); scripts.provision_roles sets each role's LOGIN password to the value below — the SAME
# value the app connects with, so they never drift. INSECURE defaults; override in every non-local
# env (the app REFUSES to boot when APP_ENV is not local/test while either is still the default).
#   oneai_app    — NO BYPASSRLS → tenant engine; RLS enforces against it.
#   oneai_global — BYPASSRLS    → global engine; cross-org / pre-org flows (login, platform, erasure).
ONEAI_APP_PASSWORD=dev-only-oneai-app-pw-change-me
ONEAI_GLOBAL_PASSWORD=dev-only-oneai-global-pw-change-me

# ── Backend ─────────────────────────────────────────────
APP_ENV=local
BACKEND_PORT=8000
# Fixed demo-org id — used ONLY by the dev seed (scripts/seed_identity.py).
# Request tenant context now derives from the verified JWT, never this value.
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# ── Identity / JWT ──────────────────────────────────────
# Signs HS256 access tokens. INSECURE default — override in every non-local env.
# The app REFUSES to boot when APP_ENV=production while this is still the default.
JWT_SECRET=dev-only-insecure-secret-change-me-in-prod
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Connectors ──────────────────────────────────────────
# Encrypts stored connector credentials (e.g. IMAP app passwords) at rest (AES-256-GCM).
# INSECURE default — override in every non-local env with a strong key: `openssl rand -base64 32`.
# Validated lazily when a connector is used (a connector-less deployment still boots).
CONNECTOR_SECRET_KEY=dev-only-insecure-connector-secret-change-me

# ── Frontend ────────────────────────────────────────────
FRONTEND_PORT=5173
# URL the BROWSER uses to reach the API (host port, not the compose hostname).
# NOTE: if you change BACKEND_PORT above, update this to match (e.g. http://localhost:9000).
VITE_API_URL=http://localhost:8000
